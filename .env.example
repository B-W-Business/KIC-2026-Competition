# Required for SEC requests. Use an organization contact, e.g. KIC Research research@example.org
SEC_USER_AGENT=KIC Research your-contact@example.org

# Optional APIs. SEC submissions and company facts work without keys.
FRED_API_KEY=
COMTRADE_API_KEY=
SAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
E2B_API_KEY=

# Background monitor API. Keep the API bound to localhost unless protected by a reverse proxy.
MONITOR_INTERVAL_SECONDS=900
MONITOR_API_URL=http://127.0.0.1:8000
